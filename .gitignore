# 构建产物
bin/
obj/
# artifacts/ 整体忽略，但基线必须入库——否则 CI 上没有可比对的对象。
# git 的否定规则要求父目录先不被整体排除，所以这里逐级放开。
artifacts/*
!artifacts/baseline
artifacts/baseline/*
!artifacts/baseline/*.nupkg
TestResults/

# IDE
.vs/
.idea/
*.user
*.suo

# 环境产物（本机代理工具目录，不属于项目）
.v2c/
.video_agent/
tmpwebapp-*.log
*.log

# 系统
.DS_Store
Thumbs.db
