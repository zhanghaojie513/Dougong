# 构建产物
bin/
obj/
# artifacts/ 整体忽略，但基线必须入库——否则 CI 上没有可比对的对象。
# git 的否定规则要求父目录先不被整体排除，所以这里逐级放开。
artifacts/*
!artifacts/baseline
artifacts/baseline/*
!artifacts/baseline/*.nupkg
TestResults/

# IDE
.vs/
.idea/
*.user
*.suo

# 环境产物（本机代理工具目录，不属于项目）
.v2c/
.video_agent/
tmpwebapp-*.log
*.log

# 系统
.DS_Store
Thumbs.db

# L1 验收 1 的实跑结果（含 provider 组合与逐任务数字，属本地测量记录）
artifacts/l1-matrix*.jsonl

# Python 缓存
__pycache__/
*.pyc

# 检查用的临时探针工程（加载后 dll 被锁，进程内删不掉）
samples/_tool-probe/
samples/_load-plugin-probe/

# dotnet tool 打包输出
artifacts/tool/
assets/brand/_*.zip
