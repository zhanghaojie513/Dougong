<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dougong</ToolCommandName>
    <Description>dougong——headless 参考宿主（dotnet tool）</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CLI 是 `dotnet tool` 包，公开面是命令行参数而不是 API；
         它的类型是参考宿主的装配细节，不产生 XML 文档。
         这与 SDK 包（Kernel/Agent/Ai/Mcp/Acp）不同——那些要给插件作者看。 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 必须同时清 DocumentationFile：Directory.Build.targets 按 IsPackable 设了它，
         而 CLI 的 IsPackable 为 true（PackAsTool）。只设 GenerateDocumentationFile=false
         不够——编译器仍会按 DocumentationFile 报注释语法错误。 -->
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 验收套件要检查真实工具的资源键声明（G5）。
         工具本身是 internal——它们不该是 SDK 的公开面，但"是否声明了资源键"
         必须能被验收看到，否则又是"能力实现了但没人用"。 -->
    <InternalsVisibleTo Include="Dougong.Agent.Comparison" />
  </ItemGroup>

  <ItemGroup>
    <!-- 终端呈现：颜色自动降级、CJK 宽度、表格/边框。
         只有 Cli 用它，SDK 包保持零 UI 依赖（architecture 边界测试断言）。 -->
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dougong.Kernel\Dougong.Kernel.csproj" />
    <ProjectReference Include="..\Dougong.Agent\Dougong.Agent.csproj" />
    <!-- 内核接线（KernelAgentHost / KernelAgentRuntime）在 Hosting 包里：
         CLI 与 Desktop 共用它，不再各自实现一遍。 -->
    <ProjectReference Include="..\Dougong.Hosting\Dougong.Hosting.csproj" />
    <ProjectReference Include="..\Dougong.Ai\Dougong.Ai.csproj" />
    <ProjectReference Include="..\Dougong.Mcp\Dougong.Mcp.csproj" />
    <ProjectReference Include="..\Dougong.Acp\Dougong.Acp.csproj" />
  </ItemGroup>

</Project>
