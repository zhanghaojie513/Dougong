<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Dougong Mcp 层——MCP server ↔ 插件桥接（底座官方 ModelContextProtocol SDK，M2 引入）</Description>
  </PropertyGroup>
  <!-- API 兼容检查：与上一个发布版本比对公开 API。
       本项目 0.x 不做向后兼容承诺，但**变更必须可见**——
       没有检出的话，破坏性改动会一路绿灯到发布之后才被发现。 -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselinePath>$(MSBuildThisFileDirectory)../../artifacts/baseline/$(AssemblyName).nupkg</PackageValidationBaselinePath>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 工具桥接要把远端工具表达成 Dougong 的 IAgentTool，因此需要 Agent 契约。 -->
    <ProjectReference Include="..\Dougong.Agent\Dougong.Agent.csproj" />
  </ItemGroup>

</Project>
